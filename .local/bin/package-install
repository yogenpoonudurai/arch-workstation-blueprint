#!/usr/bin/env bash
# package-install — Noctalia-launcher installer, official repos only, no AUR.
# Shows "package-name<TAB>description", fuzzy search, opens Alacritty for pacman confirm.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

pick() {
  if command -v noctalia >/dev/null 2>&1; then
    noctalia dmenu -p "${1:-Package}" 2>/dev/null || true
  else
    return 1
  fi
}

list_pkgs() {
  if command -v expac >/dev/null 2>&1; then
    expac -S '%n\t%d' 2>/dev/null | sort -u
  else
    pacman -Sl 2>/dev/null | awk '{name=$2; $1=$2=""; sub(/^  +/,""); print name"\t"$0}'
  fi
}

SEL="$(list_pkgs | pick "Install package")"
[ -z "${SEL:-}" ] && exit 0

PKG="${SEL%%[[:space:]]*}"
if [[ ! "$PKG" =~ ^[a-z0-9@._+\-]+$ ]]; then
  notify-send "Arch" "Invalid package name: $PKG" 2>/dev/null || true
  exit 1
fi
if ! pacman -Si -- "$PKG" >/dev/null 2>&1; then
  notify-send "Arch" "Package not found: $PKG" 2>/dev/null || true
  exit 1
fi

exec uwsm app -- alacritty -e bash -c 'sudo pacman -S --needed -- "$1"; echo; read -rp "Done — press Enter to close…" _' _ "$PKG"
