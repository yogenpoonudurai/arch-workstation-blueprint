#!/usr/bin/env bash
# package-install — Noctalia-launcher installer, official repos + optional AUR.
# Default view is official-only (fast, trusted). Last row toggles AUR mode.
# Official installs: streamlined pacman confirm. AUR installs: full yay
# interaction WITH PKGBUILD diff (never silent — AUR is user-submitted code).
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

AUR_TOGGLE="── Search AUR ──"
BACK_TOGGLE="── Back to official repos ──"

pick() {
  noctalia dmenu -p "${1:-Package}" 2>/dev/null || true
}

list_official() {
  if command -v expac >/dev/null 2>&1; then
    expac -S '%n\t%d' 2>/dev/null | sort -u
  else
    pacman -Sl 2>/dev/null | awk '{name=$2; $1=$2=""; sub(/^  +/,""); print name"\t"$0}'
  fi
}

list_aur() {
  yay -Sl aur 2>/dev/null | awk '{print $2}' | sort -u
}

valid_name() { [[ "$1" =~ ^[a-z0-9@._+\-]+$ ]]; }

install_official() {
  local pkg="$1"
  valid_name "$pkg" || { notify-send "Arch" "Invalid package name" 2>/dev/null || true; exit 1; }
  pacman -Si -- "$pkg" >/dev/null 2>&1 || { notify-send "Arch" "Not found: $pkg" 2>/dev/null || true; exit 1; }
  exec uwsm app -- alacritty -e bash -c 'sudo pacman -S --needed -- "$1"; echo; read -rp "Done — press Enter to close…" _' _ "$pkg"
}

install_aur() {
  local pkg="$1"
  valid_name "$pkg" || { notify-send "Arch" "Invalid package name" 2>/dev/null || true; exit 1; }
  yay -Si --aur -- "$pkg" >/dev/null 2>&1 || { notify-send "Arch" "Not found in AUR: $pkg" 2>/dev/null || true; exit 1; }
  # Deliberately WITHOUT --noconfirm: review the PKGBUILD diff yourself.
  exec uwsm app -- alacritty -e bash -c 'yay -S -- "$1"; echo; read -rp "Done — press Enter to close…" _' _ "$pkg"
}

if [ "${1:-}" = "--aur" ]; then
  SEL="$(printf '%s\n%s' "$BACK_TOGGLE" "$(list_aur)" | pick "Install from AUR")"
  [ -z "${SEL:-}" ] && exit 0
  [ "$SEL" = "$BACK_TOGGLE" ] && exec "$0"
  install_aur "${SEL%%[[:space:]]*}"
else
  SEL="$(printf '%s\n%s' "$AUR_TOGGLE" "$(list_official)" | pick "Install package")"
  [ -z "${SEL:-}" ] && exit 0
  [ "$SEL" = "$AUR_TOGGLE" ] && exec "$0" --aur
  install_official "${SEL%%[[:space:]]*}"
fi
