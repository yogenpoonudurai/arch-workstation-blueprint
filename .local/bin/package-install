#!/usr/bin/env bash
# package-install — Noctalia-launcher installer, official-first + AUR on demand.
# Default view is official-only (guaranteed first, fast). First row flips to
# the cached AUR list and back — both cached, so no load flash. Official uses
# streamlined pacman confirm; AUR installs silently with defaults (your call).
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/pkg-menu"
OFFICIAL_CACHE="$CACHE_DIR/official.list"
AUR_CACHE="$CACHE_DIR/aur.list"
MAX_AGE=$((24 * 3600))
AUR_TOGGLE="── Search AUR ──"
BACK_TOGGLE="── Back to official ──"

pick() {
  noctalia dmenu -p "${1:-Package}" 2>/dev/null || true
}

stale() {
  [ -f "$1" ] || return 0
  local mtime now
  mtime="$(stat -c %Y "$1" 2>/dev/null || echo 0)"
  now="$(date +%s)"
  [ $((now - mtime)) -gt "$MAX_AGE" ]
}

refresh_official() {
  mkdir -p "$CACHE_DIR"
  if command -v expac >/dev/null 2>&1; then
    expac -S '%n\t%d [official]' 2>/dev/null | sort -u > "$OFFICIAL_CACHE.tmp"
  else
    pacman -Sl 2>/dev/null | awk '{name=$2; $1=$2=""; sub(/^  +/,""); print name"\t"$0" [official]"}' | sort -u > "$OFFICIAL_CACHE.tmp"
  fi
  mv "$OFFICIAL_CACHE.tmp" "$OFFICIAL_CACHE"
}

refresh_aur() {
  mkdir -p "$CACHE_DIR"
  yay -Sl aur 2>/dev/null | awk '{print $2"\t[aur]"}' | sort -u > "$AUR_CACHE.tmp"
  mv "$AUR_CACHE.tmp" "$AUR_CACHE"
}

if [ "${1:-}" = "--refresh" ]; then
  refresh_official & refresh_aur & wait
  notify-send "Packages" "Cache refreshed" 2>/dev/null || true
  exit 0
fi

stale "$OFFICIAL_CACHE" && refresh_official &
stale "$AUR_CACHE" && refresh_aur &
wait

valid_name() { [[ "$1" =~ ^[a-z0-9@._+\-]+$ ]]; }

install_official() {
  local pkg="$1"
  valid_name "$pkg" || { notify-send "Arch" "Invalid package name" 2>/dev/null || true; exit 1; }
  pacman -Si -- "$pkg" >/dev/null 2>&1 || { notify-send "Arch" "Not found: $pkg" 2>/dev/null || true; exit 1; }
  exec uwsm app -- alacritty -e bash -c 'sudo pacman -S --needed -- "$1"; echo; read -rp "Done — press Enter to close…" _' _ "$pkg"
}

install_aur() {
  local pkg="$1"
  valid_name "$pkg" || { notify-send "Arch" "Invalid package name" 2>/dev/null || true; exit 1; }
  yay -Si --aur -- "$pkg" >/dev/null 2>&1 || { notify-send "Arch" "Not found in AUR: $pkg" 2>/dev/null || true; exit 1; }
  exec uwsm app -- alacritty -e bash -c 'yay -S --noconfirm --answerdiff None --answerclean None -- "$1"; echo; read -rp "Done — press Enter to close…" _' _ "$pkg"
}

if [ "${1:-}" = "--aur" ]; then
  SEL="$(printf '%s\n%s' "$BACK_TOGGLE" "$(cat "$AUR_CACHE")" | pick "Install from AUR")"
  [ -z "${SEL:-}" ] && exit 0
  [ "$SEL" = "$BACK_TOGGLE" ] && exec "$0"
  install_aur "${SEL%%[[:space:]]*}"
else
  SEL="$(printf '%s\n%s' "$AUR_TOGGLE" "$(cat "$OFFICIAL_CACHE")" | pick "Install package")"
  [ -z "${SEL:-}" ] && exit 0
  [ "$SEL" = "$AUR_TOGGLE" ] && exec "$0" --aur
  install_official "${SEL%%[[:space:]]*}"
fi
