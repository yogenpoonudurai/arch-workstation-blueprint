#!/usr/bin/env bash
# package-install — Noctalia-launcher installer, official + AUR in one list.
# Single popup: rows tagged [official] / [aur]. Lists cached in ~/.cache
# (refreshed if older than 24h or via --refresh); official installs use
# streamlined pacman confirm, AUR keeps full yay diff review.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/pkg-menu"
OFFICIAL_CACHE="$CACHE_DIR/official.list"
AUR_CACHE="$CACHE_DIR/aur.list"
MAX_AGE=$((24 * 3600))

pick() {
  noctalia dmenu -p "Install package" 2>/dev/null || true
}

stale() { # file -> 0 if missing or older than MAX_AGE
  [ -f "$1" ] || return 0
  local mtime now
  mtime="$(stat -c %Y "$1" 2>/dev/null || echo 0)"
  now="$(date +%s)"
  [ $((now - mtime)) -gt "$MAX_AGE" ]
}

refresh_official() {
  mkdir -p "$CACHE_DIR"
  if command -v expac >/dev/null 2>&1; then
    expac -S '%n\t%d [official]' 2>/dev/null | sort -u > "$OFFICIAL_CACHE.tmp"
  else
    pacman -Sl 2>/dev/null | awk '{name=$2; $1=$2=""; sub(/^  +/,""); print name"\t"$0" [official]"}' | sort -u > "$OFFICIAL_CACHE.tmp"
  fi
  mv "$OFFICIAL_CACHE.tmp" "$OFFICIAL_CACHE"
}

refresh_aur() {
  mkdir -p "$CACHE_DIR"
  yay -Sl aur 2>/dev/null | awk '{print $2"\t[aur]"}' | sort -u > "$AUR_CACHE.tmp"
  mv "$AUR_CACHE.tmp" "$AUR_CACHE"
}

if [ "${1:-}" = "--refresh" ]; then
  refresh_official & refresh_aur & wait
  notify-send "Packages" "Cache refreshed" 2>/dev/null || true
  exit 0
fi

stale "$OFFICIAL_CACHE" && refresh_official &
stale "$AUR_CACHE" && refresh_aur &
wait

valid_name() { [[ "$1" =~ ^[a-z0-9@._+\-]+$ ]]; }

install_official() {
  local pkg="$1"
  valid_name "$pkg" || { notify-send "Arch" "Invalid package name" 2>/dev/null || true; exit 1; }
  pacman -Si -- "$pkg" >/dev/null 2>&1 || { notify-send "Arch" "Not found: $pkg" 2>/dev/null || true; exit 1; }
  exec uwsm app -- alacritty -e bash -c 'sudo pacman -S --needed -- "$1"; echo; read -rp "Done — press Enter to close…" _' _ "$pkg"
}

install_aur() {
  local pkg="$1"
  valid_name "$pkg" || { notify-send "Arch" "Invalid package name" 2>/dev/null || true; exit 1; }
  yay -Si --aur -- "$pkg" >/dev/null 2>&1 || { notify-send "Arch" "Not found in AUR: $pkg" 2>/dev/null || true; exit 1; }
  # Deliberately WITHOUT --noconfirm: review the PKGBUILD diff yourself.
  exec uwsm app -- alacritty -e bash -c 'yay -S -- "$1"; echo; read -rp "Done — press Enter to close…" _' _ "$pkg"
}

SEL="$(cat "$OFFICIAL_CACHE" "$AUR_CACHE" 2>/dev/null | pick)"
[ -z "${SEL:-}" ] && exit 0

PKG="${SEL%%[[:space:]]*}"
if [[ "$SEL" == *"[aur]" ]]; then
  install_aur "$PKG"
else
  install_official "$PKG"
fi
