#!/usr/bin/env bash
# power-profiles-menu — Rofi picker for power-profiles-daemon (Asus Zenbook AMD).
# Falls back to power-menu if PPD is missing.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
THEME="${ROFI_THEME:-$HOME/.config/rofi/power.rasi}"

if ! command -v powerprofilesctl >/dev/null 2>&1; then
  notify-send "Power" "power-profiles-daemon not installed — opening power menu" 2>/dev/null || true
  exec power-menu
fi

CURRENT="$(powerprofilesctl get 2>/dev/null || echo balanced)"
CHOICE="$(printf '%s\n' performance balanced power-saver | rofi -dmenu -i -p "Profile [$CURRENT]" -theme "$THEME" || true)"
[ -z "${CHOICE:-}" ] && exit 0
case "$CHOICE" in
  performance|balanced|power-saver) powerprofilesctl set "$CHOICE" ;;
esac
