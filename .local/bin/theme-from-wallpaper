#!/usr/bin/env bash
# theme-from-wallpaper <path> — wallpaper -> Matugen -> Waybar/Rofi/SwayNC/Hyprland/Alacritty
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

SRC="${1:-}"
WALL_DIR="$HOME/Pictures/Wallpapers"
CURRENT="$WALL_DIR/current.jpg"
THEME_DIR="$HOME/.config/theme"
mkdir -p "$WALL_DIR" "$THEME_DIR"

if [ -z "$SRC" ]; then
  echo "Usage: theme-from-wallpaper <path-to-image>" >&2
  exit 1
fi
if [ ! -f "$SRC" ]; then
  echo "Not found: $SRC" >&2
  exit 1
fi

cp -- "$SRC" "$CURRENT"

# 1. Matugen palette (best-effort; fallback palette kept on failure)
#    --prefer avoids the interactive prompt when headless; -j dumps JSON we parse below.
if command -v matugen >/dev/null 2>&1; then
  matugen image "$CURRENT" --mode dark --prefer saturation -j hex > "$THEME_DIR/matugen.json" 2>/dev/null \
    || echo "matugen failed, using fallback palette" >&2
else
  echo "matugen not installed, using fallback palette" >&2
fi

# 2. Generate our fragments from matugen JSON if present, else fallback
python3 - "$CURRENT" <<'PY'
import json, os, sys
from pathlib import Path
home = Path(os.environ["HOME"])
theme = home / ".config/theme"
# matugen -j output locations (plus legacy spots)
candidates = [
    home / ".config/theme/matugen.json",
    home / ".config/matugen/colors.json",
    home / ".local/share/matugen/colors.json",
]
data = None
for c in candidates:
    if c.exists():
        try:
            data = json.loads(c.read_text())
            break
        except Exception:
            pass

def unwrap(v):
    # matugen -j nests variants: {dark:{color}, default:{color}, light:{color}}
    if isinstance(v, dict):
        if isinstance(v.get("color"), str):
            return v["color"]
        for k in ("dark", "default", "light"):
            if k in v:
                r = unwrap(v[k])
                if r:
                    return r
        return None
    return v if isinstance(v, str) else None

# matugen schema varies; try common keys
def pick(*keys, default=None):
    if not isinstance(data, dict):
        return default
    # search nested
    for k in keys:
        if k in data:
            r = unwrap(data[k])
            if r:
                return r
    # colors.* scheme (flat keys, variant-nested values)
    try:
        colors = data.get("colors", {})
        if isinstance(colors, dict):
            for k in keys:
                if k in colors:
                    r = unwrap(colors[k])
                    if r:
                        return r
    except Exception:
        pass
    return default

# Normalize to #rrggbb
def norm(h, fb):
    h = (h or fb).strip()
    if not h.startswith("#"):
        return fb
    if len(h) == 9:
        h = h[:7]
    return h

if data is None:
    print("no matugen output, keeping current colors.toml")
else:
    accent = norm(pick("primary", "primary_container", default="#7aa2f7"), "#7aa2f7")
    bg = norm(pick("background", default="#0e0e11"), "#0e0e11")
    surface = norm(pick("surface", "surface_container", default="#16161a"), "#16161a")
    fg = norm(pick("on_background", "on_surface", default="#e6e6eb"), "#e6e6eb")
    muted = norm(pick("outline", default="#6b6b76"), "#6b6b76")
    dark_fg = norm(pick("on_surface_variant", "outline_variant", default="#9a9aa3"), "#9a9aa3")
    red = norm(pick("error", default="#e06c75"), "#e06c75")
    yellow = norm(pick("tertiary", default="#e5c07b"), "#e5c07b")
    green = norm(pick("secondary", default="#98c379"), "#98c379")
    (theme / "colors.toml").write_text(
f"""mode = "dark"

accent = "{accent}"
selection = "#2e2e3a"
muted = "{muted}"
border = "#2e2e36"

background = "{bg}"
dark_background = "{surface}"
darker_background = "#0a0a0e"
lighter_background = "#232329"

foreground = "{fg}"
dark_foreground = "{dark_fg}"
light_foreground = "{fg}"
bright_foreground = "#ffffff"

red = "{red}"
yellow = "{yellow}"
orange = "{yellow}"
green = "{green}"
cyan = "#56b6c2"
blue = "{accent}"
magenta = "#bb9af7"
brown = "#6b5b55"

bright_red = "{red}"
bright_yellow = "{yellow}"
bright_green = "{green}"
bright_cyan = "#56b6c2"
bright_blue = "{accent}"
bright_magenta = "#bb9af7"
""")
    (theme / "current").write_text("wallpaper")
    print(f"wallpaper palette: accent={accent} bg={bg}")
PY

theme-render
# hyprpaper 0.8.x has no preload/wallpaper IPC; it reads hyprpaper.conf on start
systemctl --user restart hyprpaper.service >/dev/null 2>&1 || uwsm app -- hyprpaper >/dev/null 2>&1 &
echo "Theme applied from $SRC"
