#!/usr/bin/env bash
# arch-menu — Arch control menu (Rofi). Says "Arch" only, not a distro.
set -euo pipefail

CHOICE="$(printf '%s\n' \
  "Install Package" \
  "Remove Package" \
  "System Update" \
  "Appearance" \
  "Network" \
  "Bluetooth" \
  "Power" | rofi -dmenu -i -p "Arch" -theme "${ROFI_THEME:-$HOME/.config/rofi/arch.rasi}" 2>/dev/null || true)"

case "${CHOICE:-}" in
  "Install Package") exec package-install ;;
  "Remove Package")  exec package-remove ;;
  "System Update")   exec uwsm app -- alacritty -e bash -c 'sudo pacman -Syu; echo; read -rp "Done — press Enter to close…" _' ;;
  "Appearance")      exec uwsm app -- nwg-look ;;
  "Network")         exec uwsm app -- alacritty -e nmtui ;;
  "Bluetooth")       exec uwsm app -- alacritty -e bluetui || exec uwsm app -- alacritty -e bluetoothctl ;;
  "Power")           exec power-menu ;;
  ""|"*" ) exit 0 ;;
esac
