#!/usr/bin/env bash
# screenshot-satty [region|full] — capture -> annotate (satty) -> save + clipboard.
# region (default): slurp picker. full: whole outputs, no overlay, so
# layer-shell popups (Noctalia menus) stay open for the shot.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

if ! command -v satty >/dev/null 2>&1; then
  notify-send "Screenshot" "satty not installed: sudo pacman -S satty" 2>/dev/null || true
  exit 1
fi

OUT="$HOME/Pictures/Screenshots"
mkdir -p "$OUT"
FILE="$OUT/shot-$(date +%Y%m%d-%H%M%S).png"

if [ "${1:-region}" = "full" ]; then
  grim - | satty --filename - --output-filename "$FILE" --copy-command wl-copy
  exit 0
fi

REGION="$(slurp -d 2>/dev/null || true)"
[ -z "${REGION:-}" ] && exit 0 # Esc pressed

grim -g "$REGION" - | satty --filename - --output-filename "$FILE" --copy-command wl-copy
