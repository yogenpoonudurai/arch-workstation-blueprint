#!/usr/bin/env bash
# theme-switch — Rofi menu: preset themes + wallpapers.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

THEME="${ROFI_THEME:-$HOME/.config/rofi/arch.rasi}"
DIR="$HOME/.config/theme/themes"
WALL="$HOME/Pictures/Wallpapers"

entries=()
for d in "$DIR"/*/; do
  [ -f "$d/colors.toml" ] || continue
  entries+=("🎨 $(basename "$d")")
done
if [ -d "$WALL" ]; then
  while IFS= read -r f; do
    entries+=("🖼 $(basename "$f")")
  done < <(find "$WALL" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.png' -o -iname '*.webp' \) | sort)
fi
[ "${#entries[@]}" -gt 0 ] || { notify-send "Theme" "No themes found" 2>/dev/null || true; exit 1; }

SEL="$(printf '%s\n' "${entries[@]}" | rofi -dmenu -i -p "Theme" -theme "$THEME" || true)"
[ -z "${SEL:-}" ] && exit 0

case "$SEL" in
  "🎨 "*) exec theme-set "${SEL#🎨 }" ;;
  "🖼 "*) exec theme-from-wallpaper "$WALL/${SEL#🖼 }" ;;
esac
