#!/usr/bin/env bash
# unified-launcher — Omarchy-style single launcher: apps + packages + power + display.
# Primary picker: hyprlauncher --dmenu (verified 0.1.6 flags); fallback: rofi -dmenu.
# Safe: fixed action allowlist, desktop IDs validated, no eval.
set -euo pipefail

PICKER="${UNIFIED_PICKER:-auto}"  # auto | hyprlauncher | rofi

list_actions() {
  printf '%s\n' \
    "⚙ Install Package" \
    "⚙ Remove Package" \
    "⚙ System Update" \
    "󰍹 Display" \
    " Network" \
    " Bluetooth" \
    "🎨 Appearance" \
    "🔒 Lock" \
    "💤 Suspend" \
    "🚪 Logout" \
    "🔄 Reboot" \
    "⏻ Shutdown"
}

# Prints "Name<TAB>ID" for visible desktop entries
list_apps() {
  python3 - <<'PY'
import glob, configparser, os
seen = set()
for p in sorted(glob.glob('/usr/share/applications/*.desktop') + glob.glob(os.path.expanduser('~/.local/share/applications/*.desktop'))):
    try:
        c = configparser.ConfigParser(interpolation=None)
        c.read(p, encoding='utf-8')
        d = c['Desktop Entry']
        if d.get('NoDisplay', 'false').lower() == 'true':
            continue
        name = d.get('Name', '').strip()
        if not name or name in seen:
            continue
        seen.add(name)
        print(f"{name}\t{p.split('/')[-1]}")
    except Exception:
        continue
PY
}

pick_with() {
  local picker="$1"
  if [ "$picker" = "hyprlauncher" ]; then
    # --dmenu reads stdin lines, prints selection
    cat | hyprlauncher --dmenu 2>/dev/null || true
  else
    cat | rofi -dmenu -i -p "Launch" -theme "${ROFI_THEME:-$HOME/.config/rofi/arch.rasi}" 2>/dev/null || true
  fi
}

resolve_picker() {
  if [ "$PICKER" != "auto" ]; then echo "$PICKER"; return; fi
  command -v hyprlauncher >/dev/null 2>&1 && echo "hyprlauncher" || echo "rofi"
}

main() {
  local apps actions combined sel picker
  actions="$(list_actions)"
  apps="$(list_apps | cut -f1)"
  combined="$(printf '%s\n%s' "$actions" "$apps")"
  picker="$(resolve_picker)"
  sel="$(printf '%s' "$combined" | pick_with "$picker")"
  [ -z "${sel:-}" ] && exit 0

  case "$sel" in
    "⚙ Install Package") exec package-install ;;
    "⚙ Remove Package")  exec package-remove ;;
    "⚙ System Update")   exec uwsm app -- alacritty -e bash -c 'sudo pacman -Syu; echo; read -rp "Done — press Enter to close…" _' ;;
    "󰍹 Display")         exec monitor-menu ;;
    " Network")         exec uwsm app -- alacritty -e nmtui ;;
    " Bluetooth")       exec uwsm app -- blueman-manager || exec uwsm app -- alacritty -e bluetoothctl ;;
    "🎨 Appearance")      exec uwsm app -- nwg-look ;;
    "🔒 Lock")           exec loginctl lock-session 2>/dev/null || exec hyprlock ;;
    "💤 Suspend")        exec systemctl suspend ;;
    "🚪 Logout")         exec uwsm stop ;;
    "🔄 Reboot")         exec systemctl reboot ;;
    "⏻ Shutdown")       exec systemctl poweroff ;;
  esac

  # Otherwise treat as app name -> resolve ID safely
  local id
  id="$(list_apps | awk -F'\t' -v want="$sel" '$1==want{print $2; exit}')"
  if [ -z "${id:-}" ]; then
    # fuzzy: strip icon prefixes user may have typed partially; try case-insensitive contains
    id="$(list_apps | grep -i -F -m1 "$sel" | cut -f2 || true)"
  fi
  [ -z "${id:-}" ] && exit 0
  [[ "$id" =~ ^[A-Za-z0-9._-]+\.desktop$ ]] || exit 1
  exec uwsm app -- gtk-launch "$id"
}

main
