#!/usr/bin/env bash
# power-menu — Rofi power menu, UWSM-aware logout.
set -euo pipefail

CHOICE="$(printf '%s\n' "Lock" "Suspend" "Logout" "Reboot" "Shutdown" \
  | rofi -dmenu -i -p "Power" -theme "${ROFI_THEME:-$HOME/.config/rofi/power.rasi}" || true)"

case "${CHOICE:-}" in
  Lock)     exec loginctl lock-session 2>/dev/null || exec hyprlock ;;
  Suspend)  exec systemctl suspend ;;
  Logout)   exec uwsm stop ;;
  Reboot)   exec systemctl reboot ;;
  Shutdown) exec systemctl poweroff ;;
  *) exit 0 ;;
esac
