@import "colors-rofi.rasi"

* {
  font: "JetBrainsMono Nerd Font 12";
}
window {
  background-color: @surface;
  border: 1px;
  border-color: @border;
  border-radius: 14px;
  width: 560px;
  padding: 14px;
}
mainbox { background-color: transparent; spacing: 10px; }
inputbar {
  background-color: transparent;
  border: 1px; border-color: @border; border-radius: 10px;
  padding: 10px 12px;
  children: [ prompt, entry ];
}
prompt {
  text-color: @accent;
  font: "JetBrainsMono Nerd Font Bold 12";
}
entry { text-color: @fg; placeholder: "Display — layout · rotate · night light…"; placeholder-color: @muted; }
listview {
  background-color: transparent;
  lines: 10; columns: 1; spacing: 5px;
  scrollbar: false;
}
element {
  background-color: transparent;
  text-color: @fg;
  border-radius: 10px;
  padding: 8px 10px;
}
element alternate { background-color: transparent; }
element selected {
  background-color: @accent;
  text-color: @bg;
}
element-text, element-icon { background-color: transparent; }
