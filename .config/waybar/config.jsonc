{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 8,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": ["custom/arch", "hyprland/workspaces"],
  "modules-right": ["network", "bluetooth", "pulseaudio", "battery", "clock"],

  "custom/arch": {
    "format": "",
    "on-click": "noctalia msg panel-toggle launcher",
    "on-click-right": "noctalia msg panel-toggle launcher",
    "tooltip": false
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "default": "•"
    },
    "persistent-workspaces": {},
    "on-click": "activate"
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} {signalStrength}%",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "uwsm app -- alacritty -e nmtui",
    "on-click-middle": "nmcli radio wifi | grep -q enabled && nmcli radio wifi off || nmcli radio wifi on"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "",
    "format-connected": "",
    "tooltip-format": "{controller_alias}\t{status}",
    "tooltip-format-connected": "{device_alias}\t{status}",
    "on-click": "uwsm app -- blueman-manager",
    "on-click-right": "uwsm app -- alacritty -e bluetoothctl",
    "on-click-middle": "bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": { "default": ["", "", ""] },
    "tooltip-format": "{volume}%",
    "on-click": "uwsm app -- pavucontrol || uwsm app -- helvum || uwsm app -- alacritty -e alsamixer",
    "on-click-right": "uwsm app -- helvum || uwsm app -- pavucontrol",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },
  "battery": {
    "format": "{icon}",
    "format-icons": ["", "", "", "", ""],
    "format-charging": "󰂄",
    "tooltip-format": "Power: {capacity}% — click for profiles",
    "states": { "warning": 30, "critical": 15 },
    "on-click": "noctalia msg panel-toggle session",
    "on-click-right": "noctalia msg panel-toggle session"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%a %d %b %H:%M}",
    "on-click": "uwsm app -- gsimplecal || uwsm app -- gnome-calendar || uwsm app -- alacritty -e cal -y"
  }
}
